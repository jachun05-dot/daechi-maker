{
  "name": "daechi-maker",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run build && cap sync android && cap open android",
    "cap:ios": "npm run build && cap sync ios && cap open ios",
    "images": "vite-node scripts/images.ts"
  },
  "dependencies": {
    "@capacitor/core": "7.6.9",
    "pixi.js": "8.22.0",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@capacitor/android": "7.6.9",
    "@capacitor/cli": "7.6.9",
    "@capacitor/ios": "7.6.9",
    "@types/node": "22.15.30",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "6.4.4",
    "vite-node": "^3.2.4",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "3.2.7"
  }
}
